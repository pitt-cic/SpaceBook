# Deploy-time settings for the CDK stack. Copy to infra/.env (gitignored);
# deploy-infra.sh loads it before `cdk deploy`, and infra-stack.ts passes the
# values to the Lambdas as environment variables. Plain `npx cdk deploy`
# reads the same names from your shell environment.

# --- SES sender (required) -------------------------------------------------
# From address for sign-in codes and notification emails. No default: it must be
# verified in Amazon SES in the deploying account/region. deploy-infra.sh also
# accepts --ses-sender-email, reuses an existing stack's value, and otherwise
# asks for it. Plain `npx cdk` needs this or -c sesSenderEmail=....
# SES_SENDER_EMAIL=spacebook@example.edu

# --- Calendar invites (see DEVELOPER_GUIDE.md "Calendar Invites") ----------
# Off unless "true". Invites go to each booking's requester and the staff
# member who approved it; everything below is optional.
CALENDAR_INVITES_ENABLED=false

# Organizer + sender. Defaults to the app's SES sender (SES_SENDER_EMAIL above). Must be SES-verified, on a domain with SPF and DKIM.
# CALENDAR_INVITE_FROM=spacebook@example.edu

# Right-hand side of each invite's UID (booking-<id>@<domain>). Defaults to the
# sender's domain. Don't change it once in use: that orphans existing events.
# CALENDAR_UID_DOMAIN=spacebook.example.edu

# A CEC calendar mailbox that also gets every invite, and per-site overrides
# as JSON {"<site id>": "<mailbox>"}.
# CALENDAR_INVITE_RECIPIENT=cec-calendar@example.edu
# CALENDAR_INVITE_RECIPIENT_OVERRIDES={"hill-district":"hill-calendar@example.edu"}

# Timezone of booking times (default America/New_York).
# CALENDAR_TIMEZONE=America/New_York

# App base URL, for a "Staff view" link in staff copies of each invite.
# SPACEBOOK_APP_URL=https://main.d1234567890.amplifyapp.com
